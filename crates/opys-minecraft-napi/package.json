{
  "name": "@opys/minecraft-binding",
  "version": "0.2.0",
  "description": "napi-rs binary binding for the opys Minecraft loader family. Not consumed directly \u2014 re-exported by @opys/minecraft-vanilla and the loaders built on it.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "opys-minecraft",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmoniya-net/opys.git",
    "directory": "crates/opys-minecraft-napi"
  },
  "publishConfig": {
    "access": "public"
  }
}
